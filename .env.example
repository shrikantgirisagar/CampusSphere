# CampusSphere — Environment Variables Template
# Copy this file to .env and configure your variables

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# Server Port
PORT=3000

# Session & Token Signing Secret (CRITICAL: In production, must be a cryptographically random key of min 32 characters)
# Example (generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_a_secure_random_32_character_key_in_production

# Optional Initial Production Administrator Bootstrap
# If deploying to a fresh database in production, set these variables for initial one-time provisioning:
# ADMIN_BOOTSTRAP_PASSWORD=StrongAdminPasswordMin12Chars!
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_EMAIL=admin@campussphere.edu
# (Remove or unset ADMIN_BOOTSTRAP_PASSWORD after initial administrator access is verified)

# MongoDB Connection URI (Local or MongoDB Atlas)
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/CampusSphere

# MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/CampusSphere?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated list of allowed origins)
# Example: CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://campussphere.edu
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (Optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300

# Production Deployment Note:
# When deploying behind a TLS-terminating reverse proxy (e.g. Nginx, Cloudflare, AWS ALB),
# ensure the proxy forwards headers (X-Forwarded-For, X-Forwarded-Proto) for accurate
# client IP rate limiting and HSTS enforcement.
