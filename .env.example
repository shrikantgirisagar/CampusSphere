# CampusSphere — Environment Variables Template
# Copy this file to .env and configure your variables

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# Server Port
PORT=3000

# Session & Token Signing Secret (Required for production security)
SESSION_SECRET=your_super_secret_session_key_replace_in_production

# MongoDB Connection URI (Local or MongoDB Atlas)
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/CampusSphere

# MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/CampusSphere?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated list of allowed origins)
# Example: CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://campussphere.edu
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (Optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
